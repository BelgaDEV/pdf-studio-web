+  background:linear-gradient(90deg,rgba(57,239,136,.055),transparent 32%,rgba(93,124,255,.04));
+}
+.mega-menu-head>div{display:flex;flex-direction:column;gap:3px}
+.mega-menu-head span{font-size:7.5px;color:#53e690;font-weight:950;letter-spacing:.15em}
+.mega-menu-head strong{font-size:15px;color:#f0f7fd;letter-spacing:-.02em}
+.mega-menu-head>a{display:flex!important;align-items:center!important;gap:6px!important;color:#aeeec6!important;font-size:9px!important;font-weight:800!important;white-space:nowrap}
+.mega-menu-head>a:hover{color:#d8ffe7!important}
+.mega-menu-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));padding:17px 12px 14px}
+.mega-menu-column{padding:4px 10px 8px;min-width:0;border-right:1px solid rgba(35,67,91,.48)}
+.mega-menu-column:last-child{border-right:0}
+.mega-menu-eyebrow{display:block;font-size:6.5px;color:#5f7f98;font-weight:900;letter-spacing:.115em;margin:0 7px 3px}
+.mega-menu-column h3{font-size:12px;margin:0 7px 9px;color:#e9f3fb;letter-spacing:-.015em}
+.mega-menu-links{display:grid;gap:2px}
+.mega-menu-tool{
+  min-width:0;
+  display:grid!important;
+  grid-template-columns:30px minmax(0,1fr)!important;
+  gap:8px!important;
+  align-items:center!important;
+  padding:7px!important;
+  border-radius:10px;
+  color:#c6d5e3!important;
+  transition:background .14s ease,transform .14s ease;
+}
+.mega-menu-tool:hover{background:#10273a;transform:translateX(2px)}
+.mega-menu-tool-icon{
+  width:30px;height:30px;border-radius:9px;display:grid;place-items:center;
+  border:1px solid currentColor;background:rgba(255,255,255,.022);opacity:.92
+}
+.mega-menu-tool>span:last-child{min-width:0;display:flex;flex-direction:column;gap:2px}
+.mega-menu-tool b{font-size:9.4px;color:#dce8f2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.mega-menu-tool small{font-size:6.8px;color:#6e879d;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:520}
+.mega-menu-footer{
+  min-height:45px;
+  display:flex;
+  align-items:center;
+  justify-content:space-between;
+  gap:18px;
+  padding:9px 18px;
+  border-top:1px solid #19354a;
+  background:#081722;
+  color:#7791a6;
+  font-size:8px;
+}
+.mega-menu-footer>span,.mega-menu-footer>a{display:flex!important;align-items:center!important;gap:6px!important}
+.mega-menu-footer>span svg{color:#4fda8a}
+.mega-menu-footer>a{color:#9beeba!important;font-weight:850!important}
+
+/* Mantém as ferramentas de uso diário na frente antes das capacidades avançadas. */
+.home-tool-card:nth-child(-n+5){border-color:#244159}
+.home-tool-card:nth-child(-n+5) .home-tool-open{color:#91a8ba}
+
+@media(max-width:1420px){
+  .landing-shell>.topbar{padding-left:28px;padding-right:28px;gap:22px}
+  .landing-shell .desktop-nav{margin-left:10px;gap:12px;font-size:10.5px}
+  .mega-menu-button,.topbar-dropdown>button{font-size:10.5px}
+  .landing-shell .topbar-cta{padding:8px 10px}
+  .mega-menu-panel{left:20px;right:20px}
+}
+@media(max-width:1180px){
+  .landing-shell .desktop-nav{display:none}
+  .landing-shell .menu-btn{display:block}
+  .landing-shell>.topbar{height:70px;padding-left:24px;padding-right:24px}
+  .landing-shell .mobile-menu{top:70px}
+}
