+
+  it('registra os 10 fluxos críticos no harness real de navegador', () => {
+    for (const name of ['merge','split','compress','ocr','redaction','compare','protect','pdfa','word-to-pdf','prepare']) {
+      expect(harness).toContain(`'${name}'`)
