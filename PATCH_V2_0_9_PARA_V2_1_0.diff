+import { describe, expect, it } from 'vitest'
+import { readFileSync } from 'node:fs'
+import { APP_VERSION } from '../src/lib/appMeta'
+
+const pkg = JSON.parse(readFileSync(new URL('../package.json', import.meta.url), 'utf8'))
