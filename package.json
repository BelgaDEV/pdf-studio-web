{
  "name": "pdf-studio-web-client",
  "private": true,
  "version": "2.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b",
    "test": "vitest run --exclude tests/pdf-regression.test.ts",
    "test:pdf": "vitest run tests/pdf-regression.test.ts",
    "test:e2e": "playwright test",
    "security": "npm run security:prod && npm run security:all",
    "ci": "npm run check && npm run test && npm run test:pdf && npm run build && npm run performance:bundle",
    "release:commercial": "node scripts/create-commercial-release.mjs",
    "security:prod": "npm audit --omit=dev --audit-level=high",
    "security:all": "npm audit --audit-level=high",
    "performance:bundle": "node scripts/analyze-bundle.mjs",
    "build:analyze": "npm run build && npm run performance:bundle"
  },
  "dependencies": {
    "@wasm-zoo/ghostscript": "^0.7.2",
    "@wasm-zoo/qpdf": "^0.1.1",
    "docx": "^9.5.1",
    "dompurify": "^3.2.6",
    "html2canvas": "^1.4.1",
    "jspdf": "4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.8.3",
    "vite": "^7.1.7",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^27.0.0",
    "vitest": "4.1.11"
  },
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@10.9.2"
}
